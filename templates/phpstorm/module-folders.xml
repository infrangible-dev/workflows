<?xml version="1.0" encoding="UTF-8"?>
<!--
 * Folder settings that tools/configure-phpstorm.py applies to the module file of every module (.idea/<module>.iml).
 *   index:   an excluded folder with this path is no longer excluded; when a parent folder is excluded, the parent is
 *            replaced by the exclusion of all folders and files beside the path
 *   exclude: the folder is excluded
-->
<folders>
    <!--
     * Magento generates factories, proxies and interceptors (for example Magento\Framework\HTTP\Client\CurlFactory)
     * into generated/code, so PhpStorm has to index it; otherwise they are reported as undefined classes.
    -->
    <index path="generated" />
    <!--
     * Magento's LESS library (UI library): the _module.less of the modules use its variables (@media-common, ...) and
     * mixins (.lib-form-field(), ...), but PhpStorm's Composer handling excludes vendor/magento/magento2-base. Only
     * used while there is no copy in .phpstorm-magento of the workflows: configure-phpstorm.py copies the library
     * there and makes the copy a content root, because PhpStorm excludes the package again whenever the installed packages
     * changed.
    -->
    <index path="vendor/magento/magento2-base/lib/web/css/source" />
    <!-- compiled configuration, no classes -->
    <exclude path="generated/metadata" />
    <!--
     * Caches, logs and the preprocessed copies of the templates (var/view_preprocessed), deployed static files and
     * media of the Magento installation: copies of the module's templates, JavaScript and styles there are reported as
     * duplicated code.
    -->
    <exclude path="var" />
    <exclude path="pub/static" />
    <exclude path="pub/media" />
</folders>
