<?xml version="1.0" encoding="UTF-8"?>
<!--
 * Inspection settings that tools/configure-phpstorm.py writes into the "Project Default" profile of every module
 * (.idea/inspectionProfiles/Project_Default.xml). Each inspection_tool element replaces the one of the same class.
-->
<inspections>
    <!--
     * Magento plugin: requires a title on every resource in etc/acl.xml, also on <resource id="Magento_Backend::admin">,
     * which only references the root resource of Magento_Backend. Magento itself (acl.xsd) does not require it there,
     * and missing titles of own resources are reported by Magento when the merged ACL is validated.
    -->
    <inspection_tool class="AclResourceXmlInspection" enabled="false" level="ERROR" enabled_by_default="false" />
    <!--
     * Magento's vendor directory contains copies of classes inside tools, for example Composer\InstalledVersions in
     * vendor/composer, in the Composer library and in Rector (required by the Magento coding standard). PhpStorm's
     * Composer synchronization adds all of them as include paths, so the warning cannot be avoided by excluding folders.
    -->
    <inspection_tool class="PhpMultipleClassDeclarationsInspection" enabled="false" level="WEAK WARNING" enabled_by_default="false" />
    <!--
     * Constants of Zend classes are referenced via Magento's subclasses, for example Select::COLUMNS (defined in
     * Zend_Db_Select): the Magento coding standard forbids using Zend_Db_Select and other Zend classes directly
     * (Magento2.Legacy.RestrictedCode), so the quick fix of this inspection would break PHPCS.
    -->
    <inspection_tool class="PhpClassConstantAccessedViaChildClassInspection" enabled="false" level="WEAK WARNING" enabled_by_default="false" />
</inspections>
