<?xml version="1.0" encoding="UTF-8"?>
<!--
 * Inspection settings that tools/configure-phpstorm.py writes into the "Project Default" profile of every module
 * (.idea/inspectionProfiles/Project_Default.xml). Each inspection_tool element replaces the one of the same class.
-->
<inspections>
    <!--
     * Magento plugin: requires a title on every resource in etc/acl.xml, also on <resource id="Magento_Backend::admin">,
     * which only references the root resource of Magento_Backend. Magento itself (acl.xsd) does not require it there,
     * and missing titles of own resources are reported by Magento when the merged ACL is validated.
    -->
    <inspection_tool class="AclResourceXmlInspection" enabled="false" level="ERROR" enabled_by_default="false" />
    <!--
     * Magento's vendor directory contains copies of classes inside tools, for example Composer\InstalledVersions in
     * vendor/composer, in the Composer library and in Rector (required by the Magento coding standard). PhpStorm's
     * Composer synchronization adds all of them as include paths, so the warning cannot be avoided by excluding folders.
    -->
    <inspection_tool class="PhpMultipleClassDeclarationsInspection" enabled="false" level="WEAK WARNING" enabled_by_default="false" />
    <!--
     * Constants of Zend classes are referenced via Magento's subclasses, for example Select::COLUMNS (defined in
     * Zend_Db_Select): the Magento coding standard forbids using Zend_Db_Select and other Zend classes directly
     * (Magento2.Legacy.RestrictedCode), so the quick fix of this inspection would break PHPCS.
    -->
    <inspection_tool class="PhpClassConstantAccessedViaChildClassInspection" enabled="false" level="WEAK WARNING" enabled_by_default="false" />
    <!--
     * JavaScript: functions and properties of jQuery widgets (_create, _init, ...), mixins and the components of
     * x-magento-init are called by jQuery UI and Magento, which PhpStorm does not see: Magento's lib/web is part of
     * the excluded Composer packages, and Magento calls components by the names in layout XML and templates. Like the
     * PHP classes (entry points \Infrangible\*), they are used outside of the module. Unused local symbols are still
     * reported (JSUnusedLocalSymbols).
    -->
    <inspection_tool class="JSUnusedGlobalSymbols" enabled="false" level="WARNING" enabled_by_default="false" />
    <!--
     * LESS: the _module.less and _widgets.less of a module are partials that Magento imports into the styles of the
     * theme (styles-m.less, styles-l.less), after Magento's UI library and the variables of the theme. The partials
     * cannot import the library themselves without Magento importing it twice, so its variables (@media-common, ...)
     * and mixins (.lib-form-field(), ...) are always resolved by name only. PhpStorm finds them in the indexed library
     * (module-folders.xml), and unknown names are still reported (LessUnresolvedVariable, LessUnresolvedMixin).
    -->
    <inspection_tool class="LessResolvedByNameOnly" enabled="false" level="WEAK WARNING" enabled_by_default="false" />
    <!--
     * Composer: the composer.json of a module lists the requirements for the Magento projects that install it; the
     * module itself is never installed with Composer and has no composer.lock. Its vendor directory is the one of the
     * Anodosys development environment, mounted only while the environment runs, so required packages are reported as
     * not installed after "ads purge" and while PhpStorm still knows an older state of the environment. Whether the
     * requirements can be installed is checked by CI with every supported Magento version.
    -->
    <inspection_tool class="PhpNotInstalledPackagesInspection" enabled="false" level="WARNING" enabled_by_default="false" />
    <!--
     * XML: the attribute translate="true" on labels and descriptions in etc/widget.xml is declared fixed="true" in
     * Magento's widget.xsd, which PhpStorm reports as a redundant default value. Magento's phrase collector
     * (bin/magento i18n:collect-phrases) reads the XML file, not the schema, and collects only nodes that carry the
     * attribute, so it has to stay; Magento's own widget.xml files write it as well.
    -->
    <inspection_tool class="XmlDefaultAttributeValue" enabled="false" level="WEAK WARNING" enabled_by_default="false" />
    <!--
     * "Class can be 'readonly'": Magento generates interceptors (for plugins) and proxies as subclasses, and a class that
     * is not readonly cannot extend a readonly class, so a plugin on a readonly class of a module would end in a fatal
     * error. The PHPStan rules of the workflows are readonly classes where possible; tools/check-code-conventions.sh
     * checks them.
    -->
    <inspection_tool class="PhpClassCanBeReadonlyInspection" enabled="false" level="WEAK WARNING" enabled_by_default="false" />
    <!--
     * Duplicated code: the shared configuration (scope "Shared configuration" of scopes.xml) is the same in every
     * module, also in the Infrangible modules in the vendor folder of the development environment. Duplicates in the
     * code of the module are still reported, here and by tools/check-duplicated-code.sh in CI.
    -->
    <inspection_tool class="DuplicatedCode" enabled="true" level="WEAK WARNING" enabled_by_default="true">
      <scope name="Shared configuration" level="WEAK WARNING" enabled="false" />
    </inspection_tool>
</inspections>
