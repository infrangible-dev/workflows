<?xml version="1.0" encoding="UTF-8"?>
<!--
 * JavaScript libraries that tools/configure-phpstorm.py defines in every module (.idea/libraries/<name>.xml) and
 * assigns to the whole project (.idea/jsLibraryMappings.xml, merged with libraries assigned there already).
 *
 * Magento's JavaScript libraries are part of the Composer package magento/magento2-base (lib/web), which PhpStorm
 * excludes like all Composer packages, so define() of RequireJS, the functions of jQuery and jQuery UI widgets
 * (_create, _init, ...) are reported as unresolved or unused. A library makes PhpStorm read these files without
 * inspecting them. The paths are relative to the module, where the ads environment installs Magento.
-->
<libraries>
    <library name="magento-lib-web">
        <file path="vendor/magento/magento2-base/lib/web/requirejs/require.js" />
        <file path="vendor/magento/magento2-base/lib/web/requirejs/domReady.js" />
        <file path="vendor/magento/magento2-base/lib/web/jquery.js" />
        <file path="vendor/magento/magento2-base/lib/web/jquery/ui-modules/widget.js" />
        <file path="vendor/magento/magento2-base/lib/web/mage/translate.js" />
        <file path="vendor/magento/magento2-base/lib/web/mage/adminhtml/tools.js" />
        <file path="vendor/magento/magento2-base/lib/web/underscore.js" />
        <file path="vendor/magento/magento2-base/lib/web/knockoutjs/knockout.js" />
        <file path="vendor/magento/magento2-base/lib/web/prototype/prototype.js" />
    </library>
    <!--
     * Scripts of Magento's modules that the modules extend (widgets like $.mage.priceBox, mixins of the swatch renderer)
     * or use. They are part of the excluded Composer packages magento/module-*, so methods of the parent widgets (for
     * example reloadPrice() of the price box) are reported as unresolved. Add a script here when a module extends or
     * uses another one.
    -->
    <library name="magento-modules-web">
        <file path="vendor/magento/module-catalog/view/base/web/js/price-box.js" />
        <file path="vendor/magento/module-catalog/view/base/web/js/price-options.js" />
        <file path="vendor/magento/module-catalog/view/base/web/js/price-utils.js" />
        <file path="vendor/magento/module-catalog/view/frontend/web/js/catalog-add-to-cart.js" />
        <file path="vendor/magento/module-bundle/view/base/web/js/price-bundle.js" />
        <file path="vendor/magento/module-configurable-product/view/frontend/web/js/configurable.js" />
        <file path="vendor/magento/module-swatches/view/base/web/js/swatch-renderer.js" />
        <file path="vendor/magento/module-customer/view/frontend/web/js/customer-data.js" />
        <file path="vendor/magento/module-checkout/view/frontend/web/js/checkout-data.js" />
        <file path="vendor/magento/module-checkout/view/frontend/web/js/model/shipping-save-processor/payload-extender.js" />
        <file path="vendor/magento/module-ui/view/base/web/js/modal/modal.js" />
        <file path="vendor/magento/module-ui/view/base/web/js/modal/alert.js" />
    </library>
    <!--
     * Declarations of the Google Maps JavaScript API, which Google loads at runtime (maps.googleapis.com). Without
     * them PhpStorm resolves google.maps.Map to the built-in Map of JavaScript and reports the arguments of
     * new google.maps.Map(element, options) as invalid. Relative to the module like the PHP stubs.
    -->
    <library name="google-maps">
        <file path="../workflows/templates/phpstorm/stubs/google-maps.d.ts" />
    </library>
</libraries>
