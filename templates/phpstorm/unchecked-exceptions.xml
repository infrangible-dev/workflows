<?xml version="1.0" encoding="UTF-8"?>
<!--
 * Exceptions that PhpStorm does not require in @throws tags (Settings | PHP | Analysis | Unchecked Exceptions),
 * which tools/configure-phpstorm.py adds to .idea/php.xml of every module. A stored list replaces the defaults of
 * PhpStorm, so they are listed as well.
-->
<unchecked_exceptions>
    <!-- defaults of PhpStorm -->
    <fqn value="\Error" />
    <fqn value="\LogicException" />
    <fqn value="\RuntimeException" />
    <!--
     * PHPUnit declares interfaces like PHPUnit\Framework\MockObject\Exception in @throws of createMock(), so every test
     * would have to list them, although they only signal broken tests. PhpStorm does not follow the interface
     * hierarchy, so every interface is listed, not only their base interface PHPUnit\Exception.
    -->
    <fqn value="\PHPUnit\Exception" />
    <fqn value="\PHPUnit\Framework\MockObject\Exception" />
    <fqn value="\PHPUnit\Framework\SkippedTest" />
    <fqn value="\PHPUnit\Runner\Exception" />
    <fqn value="\PHPUnit\Util\Exception" />
    <!--
     * Thrown by Magento\Framework\DB\Select (getPart(), reset(), ...) for invalid parts of a query, which is a
     * programming error, so callers would only have to pass it on.
    -->
    <fqn value="\Zend_Db_Select_Exception" />
</unchecked_exceptions>
